{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientFrame",
  "type": "object",
  "properties": {
    "ts_ms": {
      "description": "Sender wall-clock time in Unix epoch milliseconds.",
      "type": "integer",
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0
    },
    "v": {
      "description": "Protocol major version number.",
      "type": "integer",
      "format": "uint16",
      "maximum": 1,
      "minimum": 1
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "client": {
          "$ref": "#/$defs/ClientIdentity"
        },
        "nonce": {
          "description": "A fresh 32-byte nonce, encoded as unpadded base64url.",
          "type": "string"
        },
        "protocol_major": {
          "description": "Protocol major version number spoken by the client.",
          "type": "integer",
          "format": "uint16",
          "maximum": 1,
          "minimum": 1
        },
        "type": {
          "type": "string",
          "const": "client.hello"
        }
      },
      "required": [
        "type",
        "protocol_major",
        "nonce",
        "client"
      ]
    },
    {
      "type": "object",
      "properties": {
        "proof": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "client.auth"
        }
      },
      "required": [
        "type",
        "proof"
      ]
    }
  ],
  "required": [
    "v",
    "ts_ms"
  ],
  "$defs": {
    "ClientIdentity": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ]
    }
  }
}
